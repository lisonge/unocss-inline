{
  "name": "unocss-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter unocss-inline test",
    "dev": "pnpm --filter unocss-example dev"
  },
  "dependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "error"
    }
  }
}
